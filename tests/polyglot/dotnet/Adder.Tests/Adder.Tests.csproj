<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mirrors the xunit.v3 4.x template for net10.0 (Microsoft.Testing.Platform
       v2; ../global.json routes `dotnet test` through it). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Adder/Adder.csproj" />
  </ItemGroup>

</Project>
