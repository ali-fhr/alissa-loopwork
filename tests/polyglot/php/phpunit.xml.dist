<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php"
         colors="false"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true">
    <testsuites>
        <testsuite name="smoke">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
</phpunit>
